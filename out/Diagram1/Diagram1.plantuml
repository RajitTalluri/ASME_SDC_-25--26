@startuml ASME SDC 25-26 Diagram

package Computing {
usecase "Arduino" as Ad
usecase "ESP"
}

package ColorSensor {
usecase "Neural Network model" as NN
usecase "Color Sensor Live Values" as LV
usecase "Prediction" as Pd
usecase "Physical Switch" as PS
}

package DriveTrain {
usecase "DriveTrain" as DT
}

package Collection {
usecase "Collection" as Col
}

package Power {
usecase "Battery" as B
usecase "Buck Converter 1" as BC1
usecase "Buck Converter 2" as BC2
}


(Xbox Controller) --> Ad #black;text:black : Controller Inputs


'DRIVETRAIN
Ad --> DT


'COLLECTION
Ad --> Col


'COLORSENSOR
ESP --> LV
LV --> ESP #black;line.dashed;
ESP --> NN #black;line.dashed;
NN --> Pd #black;line.dashed;
Pd --> ESP #black;line.dotted;
ESP --> PS #black;line.dotted;

'POWER
B --> BC1
B --> BC2
BC1 --> Ad #black;text:black : Uses 5V
BC2 --> ESP #black;text:black : Uses 3.3V


@enduml