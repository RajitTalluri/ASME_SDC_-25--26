#include <Bluepad32.h>

ControllerPtr myControllers[BP32_MAX_GAMEPADS];
Servo myServo;

void onConnectedController(ControllerPtr ctl) {
    Serial.println("Connected!");
}

void onControllerDisconnect(ControllerPtr ctl) {
    Serial.println("Disconnected!");
}

void setup() {
    // Opens serial communictaion at 115,200 bits/s
    Serial.begin(115200);

    BP32.setup(&onConnectedController, &onControllerDisconect

    myServo.attach(13)
}

void loop() {
    BP32.update(); // Keeps connection to controller alive
    // Read controller states here
    for (int i = 0; i < BP32_MAX_GAMEPADS; i++) {
        ControllerPtr ctl = myControllers[i];

        // Safety Check
        if (ctl && ctl->isConnected()) {
          int joyX = ctl->axisX();

          // Map joystick range to servo range
          int angle = map(joyX, -512, 512, 0, 180);
          
          // Real time servo atuation to specified angle
          myServo.write(angle);

          // Read inputs here
          Serial.println(angle);
        }
    }
}
